NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/my_db?schema=public
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Internal endpoint: used for all server-side data operations (bucket check,
# uploads, deletes). Must be reachable from the app (e.g. a Docker bridge IP).
MINIO_ENDPOINT=localhost
MINIO_PORT=9100
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET=app-uploads

# Public endpoint: used ONLY to sign presigned download URLs so they are
# reachable from a browser. The host is part of the SigV4 signature, so it
# cannot be rewritten after signing. Leave unset to reuse the internal
# endpoint above. In prod, set this to the host-exposed MinIO address:
# MINIO_PUBLIC_ENDPOINT=100.92.245.124
# MINIO_PUBLIC_PORT=9100

# Weekly hard-delete (purge) job. When enabled, soft-deleted files older than
# HARD_DELETE_RETENTION_DAYS are permanently removed from MinIO and the DB.
HARD_DELETE_ENABLED=false
HARD_DELETE_RETENTION_DAYS=365

# Pending upload rows are purged when they are not confirmed before this TTL.
PENDING_FILE_TTL_HOURS=24

# Cron expression for the pending-file cleanup job.
PENDING_FILE_CLEANUP_CRON=0 0 * * *
